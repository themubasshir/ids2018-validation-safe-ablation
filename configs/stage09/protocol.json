  "methodology": {
    "assessment_type": "Descriptive post-selection calibration assessment without recalibration",
    "recalibration_performed": false,
    "model_selection_performed": false,
    "threshold_selection_performed": false,
    "balanced_model": "XGBoost Tuned",
    "balanced_threshold": 0.51,
    "security_model": "LightGBM Tuned",
    "security_threshold": 0.26,
    "primary_bin_count": 15,
    "bin_sensitivity_counts": [10, 15, 20],
    "uniform_edges": "np.linspace(0.0, 1.0, n_bins + 1)",
    "quantile_edges": "np.quantile(probabilities, np.linspace(0.0, 1.0, n_bins + 1)); force endpoints 0/1; np.unique; fallback [0,1]",
    "bin_assignment": "np.digitize(probabilities, edges[1:-1], right=True)",
    "empty_bins": "omitted",
    "brier_score": "mean((probabilities - labels) ** 2)",
    "log_loss_clipping": [1e-15, 0.999999999999999],
    "ece": "sum(bin_weight * abs(mean_probability - observed_frequency))",
    "mce": "max(abs(calibration_gap))",
    "rmsce": "sqrt(sum(bin_weight * calibration_gap ** 2))",
    "bootstrap_method": "Paired class-stratified percentile bootstrap",
