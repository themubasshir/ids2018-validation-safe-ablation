      "size": 20000,
      "class_counts": {"benign": 11963, "attack": 8037},
      "feature_count": 78,
      "representation": "raw unscaled tabular flow features"
    },
    "initial_lime": {
      "samples": 5000,
      "features": 15,
      "base_seed": 130500,
      "paired_model_seed": true,
      "discretizer": "quartile",
      "sample_around_instance": false,
      "distance_metric": "euclidean"
    },
    "selected_lime": {
      "config_id": "continuous_wide_10k",
      "samples": 10000,
      "features": 15,
      "discretize_continuous": false,
      "sample_around_instance": true,
      "kernel_width": 8.831760866327848,
      "selection_base_seed": 136000
    },
    "perturbation_base_seeds": [137000, 138000, 139000, 140000, 141000],
    "perturbation_replicates_per_case_model": 5,
    "top_k_values": [5, 10, 15],
    "tree_shap_output_space": "raw model score/log-odds",
    "agreement_metrics": ["top-k Jaccard", "absolute and signed cosine", "absolute and signed Spearman", "shared-feature sign agreement"],
    "full_panel_base_seed": 137700,
    "reliability_rule": {
      "fidelity": "decision agreement and local R2 >= 0.30 and fidelity gap <= 0.10",
      "cross_method": "top-10 Jaccard >= 0.40 and absolute attribution cosine >= 0.50",
      "warning": "Study-specific descriptive criteria; not universal XAI standards"
