  "methodology": {
    "random_state": 42,
    "artifact_discovery": "Search /kaggle/working and /kaggle/input; shortest matching path is preferred",
    "holdout_reconstruction": "Repeat seed-42 stratified 64/16/20 split and require archived target probability and metric agreement",
    "holdout_reconstruction_authorized_in_extraction": false,
    "models_and_thresholds": {"xgboost": 0.51, "lightgbm": 0.26},
