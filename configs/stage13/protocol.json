      "unique_shared_cases": 60,
      "disagreement_pool": 2253,
      "selected_disagreement_cases": 12,
      "nearest_threshold": 2,
      "probability_quantiles": [0.1, 0.25, 0.5, 0.75, 0.9],
      "maximum_prediction_confidence": 1,
      "tie_breaker": "holdout_position"
