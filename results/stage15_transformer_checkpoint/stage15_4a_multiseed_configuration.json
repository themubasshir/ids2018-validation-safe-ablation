{
  "stage": "15.4A",
  "purpose": "Independent from-scratch robustness comparison after seed-42 architecture screening",
  "confirmation_seeds": [
    7,
    29,
    101
  ],
  "architecture_screening_seed_excluded": 42,
  "training_protocol": {
    "batch_size": 1024,
    "maximum_epochs": 40,
    "early_stopping_patience": 6,
